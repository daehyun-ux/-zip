{
  "name": "meogeobwat-zip",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild joripspace/src/index.js --bundle --format=esm --platform=browser --target=es2022 --loader:.html=text --loader:.webmanifest=text --loader:.png=binary --loader:.woff2=binary --outfile=dist/worker.js",
    "joripspace:deploy": "npm run build && npx --yes @joripspace/cli@latest deploy --cwd . --dir \"dist\" --entrypoint \"worker.js\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "hono": "^4.7.0"
  }
}
